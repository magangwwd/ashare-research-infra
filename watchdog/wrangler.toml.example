name = "ashare-task01-watchdog"
main = "worker.mjs"
compatibility_date = "2026-10-01"

[triggers]
# Example aligned with checked-in wrangler.toml as of 2026-11-03.
# Checks at 00:20, 01:20, 02:20 and 06:20 Asia/Shanghai (UTC+08),
# following the preceding day's Task01 21:17 / 23:30 slots.
# A committed config does not prove that Cloudflare deployed these triggers.
# Verify deployed Cron Triggers and actual scheduled invocations separately.
crons = ["20 16 * * *", "20 17 * * *", "20 18 * * *", "20 22 * * *"]

[secrets]
required = ["GITHUB_TOKEN"]
